const SPREADSHEET_ID='ISI_SPREADSHEET_ID',FOLDER_ID='ISI_FOLDER_DRIVE_ID';function doGet(){return out({ok:true})}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}function sh(n){return SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(n)}function doPost(e){try{let x=JSON.parse(e.postData.contents);if(x.action==='attendance')return attendance(x);if(x.action==='request')return request(x);if(x.action==='history')return history(x);if(x.action==='profile')return profile(x);return out({ok:false,message:'action salah'})}catch(e){return out({ok:false,message:e.message})}}function user(email){let v=sh('Users').getDataRange().getValues(),h=v.shift(),i=h.indexOf('email');let r=v.find(a=>String(a[i]).toLowerCase()===String(email).toLowerCase());return r?r.reduce((o,c,j)=>(o[h[j]]=c,o),{}):null}function attendance(x){let u=user(x.email);if(!u)return out({ok:false,message:'Akun belum terdaftar'});if(String(u.mode||'KANTOR').toUpperCase()==='KANTOR'){let la=+PropertiesService.getScriptProperties().getProperty('OFFICE_LAT'),lo=+PropertiesService.getScriptProperties().getProperty('OFFICE_LNG'),rad=+(PropertiesService.getScriptProperties().getProperty('OFFICE_RADIUS')||200);if(dist(x.lat,x.lng,la,lo)>rad)return out({ok:false,message:'Di luar radius kantor'})}let f=DriveApp.getFolderById(FOLDER_ID).createFile(Utilities.newBlob(Utilities.base64Decode(x.photoData.split(',')[1]),'image/jpeg','absen_'+Date.now()+'.jpg'));let n=new Date(),d=Utilities.formatDate(n,Session.getScriptTimeZone(),'yyyy-MM-dd'),t=Utilities.formatDate(n,Session.getScriptTimeZone(),'HH:mm:ss');sh('Attendance').appendRow([d,x.uid,x.email,x.name,t,x.lat,x.lng,'Kecamatan sekitar lokasi',f.getUrl()]);return out({ok:true,message:'Absensi berhasil'})}function request(x){sh('Requests').appendRow([new Date(),x.uid,x.email,x.name,x.type,x.start,x.end,x.reason,'MENUNGGU']);return out({ok:true,message:'Pengajuan terkirim'})}function history(x){let v=sh('Attendance').getDataRange().getValues(),h=v.shift(),i=h.indexOf('email'),d=h.indexOf('tanggal');let a=v.filter(r=>r[i]===x.email&&(String(r[d]).startsWith(x.month)));return out({ok:true,data:a.map(r=>({tanggal:r[d],masuk:r[4]}))})}function profile(x){return out({ok:true,data:user(x.email)||{}})}function dist(a,b,c,d){let R=6371000,p=Math.PI/180,q=Math.sin((c-a)*p/2)**2+Math.cos(a*p)*Math.cos(c*p)*Math.sin((d-b)*p/2)**2;return 2*R*Math.asin(Math.sqrt(q))}